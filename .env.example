NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
SESSION_DURATION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `npm run seed:admin`. The seed requires a password change on first access.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Dokploy/private network option. Prefer this in production.
# DATABASE_URL=postgresql://postgres:change_me@mendoza-mendozadb-1tb4oh:5432/mendoza_db

# Local Docker database defaults
POSTGRES_DB=mendoza_db
POSTGRES_USER=mendoza_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Local/separate TypeORM variables. Used only when DATABASE_URL is not set.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mendoza_user
DATABASE_PASSWORD=change_me
DATABASE_NAME=mendoza_db
