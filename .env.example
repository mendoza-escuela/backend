NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Cantidad exacta de proxies confiables delante de NestJS (Nginx suele ser 1).
# Mantener 0 si la API recibe conexiones directas.
TRUST_PROXY_HOPS=0

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
SESSION_DURATION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
# Configurar estos valores habilita recuperación de contraseña y correos de alta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `npm run seed:admin`. The seed requires a password change on first access.
INITIAL_ADMIN_FIRST_NAME=Administrador
INITIAL_ADMIN_LAST_NAME=Inicial
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Dokploy/private network option. Prefer this in production.
# DATABASE_URL=postgresql://postgres:change_me@mendoza-mendozadb-1tb4oh:5432/mendoza_db

# Local Docker database defaults
POSTGRES_DB=mendoza_db
POSTGRES_USER=mendoza_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Local/separate TypeORM variables. Used only when DATABASE_URL is not set.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mendoza_user
DATABASE_PASSWORD=change_me
DATABASE_NAME=mendoza_db

# Temporary questionnaire import limits (files are processed in memory).
SURVEY_IMPORT_MAX_FILE_MB=5
SURVEY_IMPORT_MAX_ROWS=2000

# Branding parametrizable de reportes. Las rutas vacías de Mendoza y OPS usan
# los assets provisionales versionados en backend/assets/brand/official.
# Configurar una ruta reemplaza el asset correspondiente sin cambiar código.
REPORT_PROGRAM_NAME=Escuelas Promotoras de Salud
REPORT_ORGANIZATIONS=Gobierno de Mendoza · Salud · Dirección General de Escuelas · OPS/OMS
REPORT_LOGO_MENDOZA_PATH=
REPORT_LOGO_HEALTH_PATH=
REPORT_LOGO_DGE_PATH=
REPORT_LOGO_OPS_PATH=
REPORT_SIGNER_NAME=
REPORT_SIGNER_POSITION=
REPORT_SIGNATURE_PATH=
REPORT_LEGAL_TEXT=
REPORT_VERIFICATION_URL=

# Privacidad de estadísticas visibles para escuelas (desactivado hasta definición funcional).
SCHOOL_STAR_DISTRIBUTION_ENABLED=false
SCHOOL_STAR_DISTRIBUTION_SCOPE=province
SCHOOL_STAR_DISTRIBUTION_MIN_SAMPLE=5
